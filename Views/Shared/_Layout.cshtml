@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var isHomeIndex = currentController == "Home" && currentAction == "Index";
    var showSidebar = currentAction == "Index" &&
                     (currentController == "Requester" ||
                      currentController == "FacilityManager" ||
                      currentController == "Administrator");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Key Register Automation</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KEYREGISTERAUTOMATION.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buttons.dataTables.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dataTables.bootstrap5.min.css" asp-append-version="true" />

    @RenderSection("Head", required: false)
</head>
<body class="@(currentController == "Account" ? "auth-page" : "") @(isHomeIndex ? "home-page" : "")">

    <header class="app-header d-flex align-items-center px-4 justify-content-between">
        <div class="d-flex align-items-center">
            <img src="@Url.Content("~/images/picture.png")"
                 alt="Logo"
                 class="me-2"
                 style="height:32px; width:auto;" />
            <h5 class="mb-0 fw-semibold">Key Register System</h5>
        </div>

        @if (ViewBag.CurrentUserFullName != null)
        {
            <div class="text-end">
                <span class="fw-semibold">
                    <i class="bi bi-person-circle me-1"></i>
                    @ViewBag.CurrentUserFullName
                </span>
            </div>
        }
    </header>

    @if (showSidebar)
    {
        <nav class="app-sidebar position-fixed start-0" aria-label="Primary navigation">
            <div class="app-sidebar-inner d-flex flex-column h-100">
                <ul class="nav flex-column">
                    @if (currentController == "FacilityManager")
                    {
                        <li class="nav-item">
                            <button type="button" class="menu-link w-100" id="btnKeyLookup">
                                <i class="bi bi-search me-2"></i>
                                <span>Key Lookup</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button type="button" class="menu-link w-100" id="btnIssuedandOverdueAssignments">
                                <i class="bi bi-key-fill me-2"></i>
                                <span>Assigned Keys</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button type="button" class="menu-link w-100" id="btnAllAssignments">
                                <i class="bi bi-receipt me-2"></i>
                                <span>Key Manager</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button type="button" class="menu-link w-100" id="btnCreateAssignment">
                                <i class="bi bi-plus-circle me-2"></i>
                                <span>Key Assignment</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button type="button" class="menu-link w-100" id="btnAllKeys">
                                <i class="bi bi-key me-2"></i>
                                <span>Key Setup</span>
                            </button>
                        </li>
                    }
                    else if (currentController == "Administrator")
                    {
                        <li class="nav-item">
                            <button type="button" class="menu-link w-100" id="btnKeyLookup">
                                <i class="bi bi-search me-2"></i>
                                <span>Key Lookup</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button type="button" class="menu-link w-100" id="btnIssuedandOverdueAssignments">
                                <i class="bi bi-key-fill me-2"></i>
                                <span>Assigned Keys</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button type="button" class="menu-link w-100" id="btnAllAssignments">
                                <i class="bi bi-receipt me-2"></i>
                                <span>Key Manager</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button type="button" class="menu-link w-100" id="btnCreateAssignment">
                                <i class="bi bi-plus-circle me-2"></i>
                                <span>Key Assignment</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button type="button" class="menu-link w-100" id="btnAllKeys">
                                <i class="bi bi-key me-2"></i>
                                <span>Key Setup</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button type="button" class="menu-link w-100" id="btnGraphs">
                            <i class="bi bi-graph-up me-2"></i>
                            <span>Graphs</span>
                            </button>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    }

    <div class="content-area"
         style="margin-left:@(showSidebar ? "var(--sidebar-width)" : "0"); padding-top:70px;">
        <main role="main"
              class="pb-3 @(isHomeIndex ? "d-flex justify-content-center align-items-center" : "")"
              style="@(isHomeIndex ? "min-height: calc(100vh - 70px);" : "")">
            @RenderBody()
        </main>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/chart.js" asp-append-version="true"></script>
    <script src="~/js/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="~/js/dataTables.bootstrap5.min.js" asp-append-version="true"></script>
    <script src="~/js/dataTables.buttons.min.js" asp-append-version="true"></script>
    <script src="~/jszip/jszip.min.js" asp-append-version="true"></script>
    <script src="~/pdfmake/pdfmake.min.js" asp-append-version="true"></script>
    <script src="~/pdfmake/vfs_fonts.js" asp-append-version="true"></script>
    <script src="~/js/buttons.html5.min.js" asp-append-version="true"></script>
    <script>
        if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
            window.onload = function () {
                if (sessionStorage.scrollTop) {
                    window.scrollTo(0, sessionStorage.scrollTop);
                }
            };
            window.onbeforeunload = function () {
                sessionStorage.scrollTop = window.scrollY;
            };
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
